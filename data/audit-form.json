{
  "$schema_note": "Editable multi-step survey for the instant Observability Cost & Stack Audit. Rebuild with: npm run build. See EDITING.md. No FormSubmit — runs entirely client-side.",
  "formId": "o11y-cost-audit-wizard",
  "version": 2,
  "mode": "client-wizard",
  "title": "Instant Observability Cost & Stack Audit",
  "subtitle": "Answer a few questions. Estimates run in your browser against O11y Watch public pricing data — nothing is uploaded.",
  "submitLabel": "Run my audit",
  "csv": {
    "enabled": true,
    "optional": true,
    "accept": ".csv,text/csv",
    "hint": "Optional. Parsed only in your browser — never uploaded. Recognizes columns like hosts, log_gb, logs_gb_day, metrics, series, spans, retention, users, spend.",
    "maxBytes": 2097152
  },
  "steps": [
    {
      "id": "stack",
      "title": "Current stack",
      "description": "Which vendors and plans you run today.",
      "fields": [
        {
          "name": "vendors",
          "label": "Current observability vendors",
          "type": "checkbox-group",
          "required": true,
          "hint": "Select all that apply. Primary vendor should be the one driving most of the bill.",
          "options": [
            {
              "value": "datadog",
              "label": "Datadog"
            },
            {
              "value": "newrelic",
              "label": "New Relic"
            },
            {
              "value": "grafana",
              "label": "Grafana Cloud / Loki / Tempo / Mimir"
            },
            {
              "value": "splunk",
              "label": "Splunk / Splunk Observability"
            },
            {
              "value": "elastic",
              "label": "Elastic / ELK"
            },
            {
              "value": "dynatrace",
              "label": "Dynatrace"
            },
            {
              "value": "honeycomb",
              "label": "Honeycomb"
            },
            {
              "value": "signoz",
              "label": "SigNoz"
            },
            {
              "value": "coralogix",
              "label": "Coralogix"
            },
            {
              "value": "axiom",
              "label": "Axiom"
            },
            {
              "value": "sentry",
              "label": "Sentry"
            },
            {
              "value": "middleware",
              "label": "Middleware"
            },
            {
              "value": "groundcover",
              "label": "groundcover"
            },
            {
              "value": "other",
              "label": "Other / mix (note in constraints)"
            }
          ]
        },
        {
          "name": "primary_vendor",
          "label": "Primary vendor (largest share of spend)",
          "type": "select",
          "required": true,
          "options": [
            {
              "value": "",
              "label": "Select…"
            },
            {
              "value": "datadog",
              "label": "Datadog"
            },
            {
              "value": "newrelic",
              "label": "New Relic"
            },
            {
              "value": "grafana",
              "label": "Grafana Cloud"
            },
            {
              "value": "splunk",
              "label": "Splunk"
            },
            {
              "value": "elastic",
              "label": "Elastic"
            },
            {
              "value": "dynatrace",
              "label": "Dynatrace"
            },
            {
              "value": "honeycomb",
              "label": "Honeycomb"
            },
            {
              "value": "signoz",
              "label": "SigNoz"
            },
            {
              "value": "coralogix",
              "label": "Coralogix"
            },
            {
              "value": "axiom",
              "label": "Axiom"
            },
            {
              "value": "other",
              "label": "Other"
            }
          ]
        },
        {
          "name": "plans",
          "label": "Plan(s) / tier notes",
          "type": "text",
          "required": false,
          "placeholder": "e.g. Datadog Pro + APM; New Relic Standard; Grafana Cloud Pro"
        }
      ]
    },
    {
      "id": "spend",
      "title": "Spend & scale",
      "description": "Monthly bill and footprint.",
      "fields": [
        {
          "name": "monthly_spend",
          "label": "Stated monthly observability spend (USD)",
          "type": "number",
          "required": true,
          "min": 0,
          "step": 1,
          "placeholder": "4500",
          "hint": "What you actually pay (or last invoice). Used to sanity-check the model."
        },
        {
          "name": "hosts",
          "label": "Hosts / containers (or host-equivalents)",
          "type": "number",
          "required": true,
          "min": 0,
          "step": 1,
          "placeholder": "120"
        },
        {
          "name": "host_mem_gib",
          "label": "Typical host memory (GiB) — optional",
          "type": "number",
          "required": false,
          "min": 0,
          "step": 1,
          "placeholder": "8",
          "hint": "Some vendors (e.g. Dynatrace Full-Stack) bill per memory-GiB. Blank = 8 GiB."
        },
        {
          "name": "log_gb_day",
          "label": "Log volume (GB / day)",
          "type": "number",
          "required": true,
          "min": 0,
          "step": 0.1,
          "placeholder": "50"
        },
        {
          "name": "metric_series",
          "label": "Active metric series (custom / billed)",
          "type": "number",
          "required": true,
          "min": 0,
          "step": 1,
          "placeholder": "250000"
        },
        {
          "name": "spans_mo",
          "label": "Traces / spans per month",
          "type": "number",
          "required": true,
          "min": 0,
          "step": 1,
          "placeholder": "80000000"
        },
        {
          "name": "trace_gb_mo",
          "label": "Ingested trace volume (GB / month) — optional",
          "type": "number",
          "required": false,
          "min": 0,
          "step": 1,
          "placeholder": "300",
          "hint": "Datadog: Plan & Usage → APM ingested spans (GB). Lets us price GB-billed vendors exactly instead of estimating from span count."
        },
        {
          "name": "indexed_logs_m_mo",
          "label": "Indexed log events (millions / month) — optional",
          "type": "number",
          "required": false,
          "min": 0,
          "step": 1,
          "placeholder": "500",
          "hint": "Datadog: Plan & Usage → Indexed logs. Prices Datadog's per-million indexed-log line exactly."
        },
        {
          "name": "retention_days",
          "label": "Retention (days)",
          "type": "number",
          "required": true,
          "min": 1,
          "step": 1,
          "placeholder": "30"
        },
        {
          "name": "users",
          "label": "Users / seats (full-access)",
          "type": "number",
          "required": true,
          "min": 0,
          "step": 1,
          "placeholder": "12"
        },
        {
          "name": "core_users",
          "label": "Core / limited seats (optional, e.g. New Relic core users)",
          "type": "number",
          "required": false,
          "min": 0,
          "step": 1,
          "placeholder": "0"
        },
        {
          "name": "team_size",
          "label": "Engineering team size",
          "type": "select",
          "required": true,
          "options": [
            {
              "value": "",
              "label": "Select…"
            },
            {
              "value": "1-5",
              "label": "1 – 5"
            },
            {
              "value": "6-20",
              "label": "6 – 20"
            },
            {
              "value": "21-50",
              "label": "21 – 50"
            },
            {
              "value": "51-200",
              "label": "51 – 200"
            },
            {
              "value": "200+",
              "label": "200+"
            }
          ]
        }
      ]
    },
    {
      "id": "priorities",
      "title": "Priorities & constraints",
      "description": "What matters and what blocks a change.",
      "fields": [
        {
          "name": "priority",
          "label": "Primary priority",
          "type": "select",
          "required": true,
          "options": [
            {
              "value": "",
              "label": "Select…"
            },
            {
              "value": "cost",
              "label": "Cost / savings first"
            },
            {
              "value": "features",
              "label": "Features / depth first"
            },
            {
              "value": "selfhost",
              "label": "Self-host / open stack first"
            },
            {
              "value": "balanced",
              "label": "Balanced"
            }
          ]
        },
        {
          "name": "compliance",
          "label": "Compliance constraints",
          "type": "checkbox-group",
          "required": false,
          "options": [
            {
              "value": "none",
              "label": "None / not sure"
            },
            {
              "value": "soc2",
              "label": "SOC 2"
            },
            {
              "value": "hipaa",
              "label": "HIPAA"
            },
            {
              "value": "gdpr",
              "label": "GDPR / data residency"
            },
            {
              "value": "fedramp",
              "label": "FedRAMP / gov"
            },
            {
              "value": "pci",
              "label": "PCI"
            }
          ]
        },
        {
          "name": "region",
          "label": "Preferred data region",
          "type": "select",
          "required": false,
          "options": [
            {
              "value": "",
              "label": "No preference / not sure"
            },
            {
              "value": "us",
              "label": "United States"
            },
            {
              "value": "eu",
              "label": "EU / EEA"
            },
            {
              "value": "uk",
              "label": "United Kingdom"
            },
            {
              "value": "apac",
              "label": "APAC"
            },
            {
              "value": "multi",
              "label": "Multi-region required"
            }
          ]
        },
        {
          "name": "constraints",
          "label": "Other constraints",
          "type": "textarea",
          "required": false,
          "rows": 3,
          "placeholder": "Must keep X; cannot self-host; renews in 60 days…"
        },
        {
          "name": "usage_csv",
          "label": "Optional usage CSV (local parse only)",
          "type": "file",
          "required": false,
          "accept": ".csv,text/csv",
          "hint": "Never uploaded. We look for numeric columns matching hosts, logs, metrics, spans, retention, users, spend."
        }
      ]
    }
  ]
}
